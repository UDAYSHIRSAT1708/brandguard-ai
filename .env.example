# ==============================================================================
# BrandGuard AI - Full-Stack Production Environment Variables Specification
#
# Use this reference to configure your deployment environment.
# Copy individual service variables to:
#   - backend/.env
#   - frontend/.env
#   - ai-service/.env
# or supply them via Docker / Kubernetes secret managers.
# ==============================================================================

# ==========================================
# 1. NODE.JS EXPRESS BACKEND
# ==========================================
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/brandguard
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=replace_with_secure_internal_service_key
ALLOW_AUTO_SEED=false

# ==========================================
# 2. PYTHON FASTAPI AI MICROSERVICE
# ==========================================
ENVIRONMENT=production
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-flash-lite-latest
# Canonical key (or use alias GEMINI_API_KEY / GOOGLE_API_KEY):
AI_PRIMARY_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-4o-mini
# Canonical key (or use alias OPENAI_API_KEY):
AI_FALLBACK_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_CONTEXT_BUDGET_TOKENS=4000
BACKEND_URL=http://backend:5000
ALLOWED_ORIGINS=http://backend:5000,http://frontend:3000,http://localhost:3000,http://localhost:5000

# ==========================================
# 3. REACT FRONTEND
# ==========================================
VITE_API_URL=http://localhost:5000/api
VITE_ENABLE_DEMO_ACCOUNTS=false

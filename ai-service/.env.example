# ==============================================================================
# BrandGuard AI - AI Service Environment Configuration (.env.example)
# Copy this file to ai-service/.env and configure AI provider API keys.
# ==============================================================================

# Application environment (development | production)
ENVIRONMENT=production

# Internal Authentication Key (must match AI_SERVICE_API_KEY in backend)
AI_SERVICE_API_KEY=replace_with_secure_internal_service_key

# --- Primary AI Provider (Google Gemini) ---
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-flash-latest
# Canonical key (or use alias GEMINI_API_KEY / GOOGLE_API_KEY):
AI_PRIMARY_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Fallback AI Provider (OpenAI) ---
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-4o-mini
# Canonical key (or use alias OPENAI_API_KEY):
AI_FALLBACK_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Guardrails and Request Budgets ---
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_CONTEXT_BUDGET_TOKENS=4000

# --- Network & Allowed Origins (CORS) ---
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

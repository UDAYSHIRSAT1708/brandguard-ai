# ==============================================================================
# BrandGuard AI - AI Service Environment Configuration (.env.example)
# Copy this file to ai-service/.env and configure AI provider API keys.
# ==============================================================================

# Application environment (development | production)
ENVIRONMENT=production

# Internal Authentication Key (must match AI_SERVICE_API_KEY in backend)
AI_SERVICE_API_KEY=replace_with_secure_internal_service_key

# --- Primary AI Provider (Google Gemini) ---
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-flash-lite-latest
# Canonical key (or use alias GEMINI_API_KEY / GOOGLE_API_KEY):
AI_PRIMARY_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Fallback AI Provider (Groq Llama) ---
# Optional: Fallback is automatically skipped if this key does not start with 'gsk_'
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
# Canonical key (or use alias GROQ_API_KEY): Must start with gsk_...
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_API_KEY=

# --- Guardrails and Request Budgets ---
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_CONTEXT_BUDGET_TOKENS=4000

# --- Network & Allowed Origins (CORS) ---
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# ==============================================================================
# BrandGuard AI - Frontend Environment Configuration (.env.example)
# Copy this file to frontend/.env or provide these variables during Vite build.
# ==============================================================================

# Public API Gateway Base URL
VITE_API_URL=http://localhost:5000/api

# Enable Demo Accounts (Strictly disabled in production builds; opt-in for dev only)
VITE_ENABLE_DEMO_ACCOUNTS=false

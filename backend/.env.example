# ==============================================================================
# BrandGuard AI - Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and provide genuine secrets before deployment.
# ==============================================================================

# Runtime environment (development | production | test)
NODE_ENV=production

# Server Port
PORT=5000

# Primary MongoDB connection URI (Required in production)
# Example: mongodb://mongo:27017/brandguard or MongoDB Atlas connection string
MONGODB_URI=mongodb://mongo:27017/brandguard

# JWT Signing Secret (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# JWT Session Lifespan
JWT_EXPIRES_IN=24h

# Frontend Allowed Origin (for CORS and CSRF protection)
FRONTEND_URL=http://localhost:3000

# Python AI Microservice URL
AI_SERVICE_URL=http://ai-service:8000

# Shared internal secret for backend-to-AI-service handshake authentication
AI_SERVICE_API_KEY=replace_with_secure_internal_service_key

# Auto-seed database on startup (Set to true only for ephemeral dev environments)
# In production, default is false. Seed manually with 'npm run seed'.
ALLOW_AUTO_SEED=false

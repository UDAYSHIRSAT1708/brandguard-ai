# ==============================================================================
# BrandGuard AI - Git Ignore Specification
# Covers Node.js/TypeScript frontend & backend, Python AI/RAG service, and OS/IDE
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test
*.env
!*.env.example
!.env.example

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# Build & Distribution Artifacts
# ------------------------------------------------------------------------------
dist/
build/
.dist/
out/
.output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python & Virtual Environments (ai-service)
# ------------------------------------------------------------------------------
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# Python Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ------------------------------------------------------------------------------
# Frontend & Bundler Caches (Vite)
# ------------------------------------------------------------------------------
.vite/
.vite-cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# Database & Persistent Data Stores
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
mongo-data/
data/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Specifics
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# VS Code (preserve extensions/recommendations if present, ignore local workspace state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
temp/
tmp/
.temp/
.tmp/
